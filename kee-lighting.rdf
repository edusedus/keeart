  <!-- Optional: lightweight pattern for describing a prompt's lighting -->
  <owl:Class rdf:about="https://example.org/lighting-taxonomy#LightingProfile">
    <rdfs:label xml:lang="en">Lighting profile</rdfs:label>
  </owl:Class>

  <owl:ObjectProperty rdf:about="https://example.org/lighting-taxonomy#hasLightingConcept">
    <rdfs:label xml:lang="en">has lighting concept</rdfs:label>
    <rdfs:domain rdf:resource="https://example.org/lighting-taxonomy#LightingProfile"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>

  <ex:LightingProfile rdf:about="https://example.org/lighting-taxonomy#profileExample">
    <rdfs:label xml:lang="en">Example prompt lighting profile</rdfs:label>
    <ex:hasLightingConcept rdf:resource="https://example.org/lighting-taxonomy#CinematicLighting"/>
    <ex:hasLightingConcept rdf:resource="https://example.org/lighting-taxonomy#ThreePointLighting"/>
    <ex:hasLightingConcept rdf:resource="https://example.org/lighting-taxonomy#SoftLight"/>
