    <ex:hasLightingConcept rdf:resource="https://example.org/lighting-taxonomy#HighContrast"/>
    <ex:hasLightingConcept rdf:resource="https://example.org/lighting-taxonomy#RimLight"/>
    <ex:hasLightingConcept rdf:resource="https://example.org/lighting-taxonomy#MotivatedLighting"/>
  </ex:LightingProfile>

</rdf:RDF>
